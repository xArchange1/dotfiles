.shell powershell

# WM control (mirrors GlazeWM: alt+shift+o reload, alt+shift+i redraw, alt+shift+p pause, alt+shift+u exit)
alt + shift + o         : komorebic reload-configuration
alt + ctrl + o          : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden
alt + shift + i         : komorebic retile
alt + shift + p         : komorebic toggle-pause
alt + shift + u         : komorebic stop
alt + shift + oem_2     : komorebic toggle-shortcuts # oem_2 is /

# Apps
alt + return            : Start-Process wt
alt + shift + return    : Start-Process wt -Verb RunAs

# Window state
alt + q                 : komorebic close
alt + w                 : komorebic minimize
alt + r                 : komorebic toggle-float
alt + t                 : komorebic toggle-float
alt + e                 : komorebic toggle-monocle
alt + shift + e         : komorebic toggle-maximize

# Focus
alt + h                 : komorebic focus left
alt + j                 : komorebic focus down
alt + k                 : komorebic focus up
alt + l                 : komorebic focus right
alt + left              : komorebic focus left
alt + down              : komorebic focus down
alt + up                : komorebic focus up
alt + right             : komorebic focus right
alt + shift + oem_4     : komorebic cycle-focus previous # oem_4 is [
alt + shift + oem_6     : komorebic cycle-focus next # oem_6 is ]

# Move
alt + shift + h         : komorebic move left
alt + shift + j         : komorebic move down
alt + shift + k         : komorebic move up
alt + shift + l         : komorebic move right
alt + shift + left      : komorebic move left
alt + shift + down      : komorebic move down
alt + shift + up        : komorebic move up
alt + shift + right     : komorebic move right
alt + ctrl + return     : komorebic promote

# Resize (GlazeWM u/p = width, i/o = height)
alt + u                 : komorebic resize-axis horizontal decrease
alt + p                 : komorebic resize-axis horizontal increase
alt + i                 : komorebic resize-axis vertical increase
alt + o                 : komorebic resize-axis vertical decrease

# Stacks
alt + ctrl + h          : komorebic stack left
alt + ctrl + j          : komorebic stack down
alt + ctrl + k          : komorebic stack up
alt + ctrl + l          : komorebic stack right
alt + oem_1             : komorebic unstack # oem_1 is ;
alt + oem_4             : komorebic cycle-stack previous
alt + oem_6             : komorebic cycle-stack next

# Layouts
alt + x                 : komorebic flip-layout horizontal
alt + y                 : komorebic flip-layout vertical

# Scrolling layout: set visible columns
alt + ctrl + 1          : komorebic scrolling-layout-columns 1
alt + ctrl + 2          : komorebic scrolling-layout-columns 2
alt + ctrl + 3          : komorebic scrolling-layout-columns 3

# Workspace cycling
alt + a                 : komorebic cycle-workspace previous
alt + s                 : komorebic cycle-workspace next
alt + d                 : komorebic focus-last-workspace
alt + shift + a         : komorebic cycle-move-to-workspace previous
alt + shift + s         : komorebic cycle-move-to-workspace next

# Workspaces
alt + 1                 : komorebic focus-workspace 0
alt + 2                 : komorebic focus-workspace 1
alt + 3                 : komorebic focus-workspace 2
alt + 4                 : komorebic focus-workspace 3
alt + 5                 : komorebic focus-workspace 4
alt + 6                 : komorebic focus-workspace 5
alt + 7                 : komorebic focus-workspace 6

# Move window to workspace (and follow)
alt + shift + 1         : komorebic move-to-workspace 0
alt + shift + 2         : komorebic move-to-workspace 1
alt + shift + 3         : komorebic move-to-workspace 2
alt + shift + 4         : komorebic move-to-workspace 3
alt + shift + 5         : komorebic move-to-workspace 4
alt + shift + 6         : komorebic move-to-workspace 5
alt + shift + 7         : komorebic move-to-workspace 6
